{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/payments/*.js": {
      "maxDuration": 60
    },
    "api/payout.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/validation-key.txt",
      "destination": "/validation-key-mainnet.txt"
    }
  ]
}